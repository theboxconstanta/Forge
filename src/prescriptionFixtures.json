  "validateStructure": [
    { "name": "empty v1 is valid", "doc": { "version": 1, "variants": {} }, "valid": true },
    { "name": "bad version", "doc": { "version": 2, "variants": {} }, "valid": false },
    { "name": "unknown variant key", "doc": { "version": 1, "variants": { "elite": { "movements": [] } } }, "valid": false },
    { "name": "duplicate instanceId", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "A" }, { "instanceId": "x", "name": "B" } ] } } }, "valid": false },
    { "name": "missing instanceId", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "name": "A" } ] } } }, "valid": false },
    { "name": "non-numeric load", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "A", "load": { "mode": "universal", "value": "heavy", "unit": "kg" } } ] } } }, "valid": false },
    { "name": "bad load unit", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "A", "load": { "mode": "universal", "value": 40, "unit": "stone" } } ] } } }, "valid": false },
    { "name": "valid full doc", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Snatch", "canonicalMovementId": null, "reps": { "mode": "universal", "value": 20 }, "load": { "mode": "sex_specific", "male": 45, "female": 30, "unit": "kg" } } ] } } }, "valid": true },
    { "name": "null numerics allowed (draft)", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Snatch", "load": { "mode": "sex_specific", "male": 45, "female": null, "unit": "kg" } } ] } } }, "valid": true }
  ],
  "validatePublish": [
    { "name": "complete rx passes", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Snatch", "load": { "mode": "sex_specific", "male": 45, "female": 30, "unit": "kg" } } ] } } }, "valid": true },
    { "name": "missing women load blocks publish", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Snatch", "load": { "mode": "sex_specific", "male": 45, "female": null, "unit": "kg" } } ] } } }, "valid": false },
    { "name": "universal missing value blocks publish", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Row", "distance": { "mode": "universal", "value": null, "unit": "m" } } ] } } }, "valid": false },
    { "name": "no metric at all is fine (bodyweight)", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Burpee", "reps": { "mode": "universal", "value": 20 } } ] } } }, "valid": true },
    { "name": "blank reps does NOT block publish (structure, scheme carries the count)", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Thruster", "reps": { "mode": "universal", "value": null }, "load": { "mode": "sex_specific", "male": 43, "female": 30, "unit": "kg" } } ] } } }, "valid": true },
    { "name": "reps sex_specific half-entry IS flagged", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Double Under", "reps": { "mode": "sex_specific", "male": 50, "female": null } } ] } } }, "valid": false },
    { "name": "reps text scheme never blocks", "doc": { "version": 1, "variants": { "rx": { "movements": [ { "instanceId": "x", "name": "Thruster", "reps": { "mode": "text", "text": "21-15-9" }, "load": { "mode": "sex_specific", "male": 43, "female": 30, "unit": "kg" } } ] } } }, "valid": true }
  ],
  "parse": [
    { "name": "snatch @ 45/30kg", "line": "20 Snatches @ 45/30kg", "expect": { "name": "Snatches", "reps": { "mode": "universal", "value": 20 }, "load": { "mode": "sex_specific", "male": 45, "female": 30, "unit": "kg" } } },
    { "name": "snatch 45/30 kg no @", "line": "20 Snatches 45/30 kg", "expect": { "reps": { "mode": "universal", "value": 20 }, "load": { "mode": "sex_specific", "male": 45, "female": 30, "unit": "kg" } } },
    { "name": "db snatch decimal", "line": "20 DB Snatches @ 22.5/15kg", "expect": { "load": { "mode": "sex_specific", "male": 22.5, "female": 15, "unit": "kg" } } },
    { "name": "cal row sex-specific", "line": "15/12 Cal Row", "expect": { "name": "Row", "calories": { "mode": "sex_specific", "male": 15, "female": 12 } } },
    { "name": "500m row", "line": "500m Row", "expect": { "name": "Row", "distance": { "mode": "universal", "value": 500, "unit": "m" } } },
    { "name": "500 m row spaced", "line": "500 m Row", "expect": { "distance": { "mode": "universal", "value": 500, "unit": "m" } } },
    { "name": "20 cal row universal", "line": "20 Cal Row", "expect": { "calories": { "mode": "universal", "value": 20 } } },
    { "name": "400m run", "line": "400m Run", "expect": { "name": "Run", "distance": { "mode": "universal", "value": 400, "unit": "m" } } },
    { "name": "comma decimal load", "line": "10 Power Clean @ 61,5kg", "expect": { "load": { "mode": "universal", "value": 61.5, "unit": "kg" } } }
